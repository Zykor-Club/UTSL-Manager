<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UTSLManager.MainWindow"
        Title="UTSLManager" Width="900" Height="620" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#0C0E12"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
  <Window.Styles>
    <Style Selector="Border.tl:pointerover TextBlock">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.menu">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <!-- ★ 当前视图高亮 #66CCFF（用户指定）；圆角必须同时设到模板内的 ContentPresenter 上 -->
    <Style Selector="Button.menu /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.menu.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#66CCFF"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.menu.active">
      <Setter Property="Foreground" Value="#00263A"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.menu.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#7AD4FF"/>
    </Style>
  </Window.Styles>
  <Panel>
    <Grid ColumnDefinitions="244,*,208" RowDefinitions="40,*">
      <!-- ★ 标题栏：只留交通灯 + 标题（功能按钮已移到右侧菜单） -->
      <Border Grid.Row="0" Grid.ColumnSpan="3" Background="Transparent" x:Name="TitleBar" PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
            <Border x:Name="BtnClose" Classes="tl" Width="12" Height="12" CornerRadius="6" Background="#FF5F57" Cursor="Hand" PointerPressed="OnClose" ToolTip.Tip="关闭"><TextBlock Text="✕" FontSize="7" Foreground="#7A0B06" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/></Border>
            <Border x:Name="BtnMin" Classes="tl" Width="12" Height="12" CornerRadius="6" Background="#FEBC2E" Cursor="Hand" PointerPressed="OnMin" ToolTip.Tip="最小化"><TextBlock Text="−" FontSize="8" Foreground="#8A5A00" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/></Border>
            <Border x:Name="BtnMax" Classes="tl" Width="12" Height="12" CornerRadius="6" Background="#28C840" Cursor="Hand" PointerPressed="OnMax" ToolTip.Tip="最大化"><TextBlock Text="+" FontSize="8" Foreground="#0B5A18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/></Border>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="UTSLManager" FontSize="12" Foreground="#8A8A90" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border Grid.Column="2" Width="1"/>
        </Grid>
      </Border>

      <!-- 左侧栏：世界列表 -->
      <Border Grid.Row="1" Grid.Column="0" Background="#16161A" Padding="10,8,10,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="8,0,8,12">
            <TextBlock Text="UTSLManager" FontSize="14" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock Text="UnifierTSL 多世界管理器" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" x:Name="ChainText" Text="世界链: —" FontSize="11" Foreground="#6E6E76" Margin="8,8,8,2" TextWrapping="Wrap"/>
          <ListBox x:Name="WorldList" Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="16,*,Auto" Margin="0,1">
                  <Border Grid.Column="0" Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Center" Background="{Binding DotBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="11" Foreground="#9BA3AE" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 中间：控制台（收窄 ✓ 居中 ✓） -->
      <Panel Grid.Row="1" Grid.Column="1" Margin="18,0">
      <Grid x:Name="ConsoleView" RowDefinitions="Auto,Auto,Auto,*" HorizontalAlignment="Stretch">
        <Grid Grid.Row="0" Margin="0,4,0,12" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="控制台" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="TargetText" Text="目标: 全部世界" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="ErrText" Margin="0,0,0,8" FontSize="11" Foreground="#FF9C94" TextWrapping="Wrap"/>

        <!-- 监控卡片 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,0,0,12">
          <Border Grid.Column="0" Background="#17171A" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,0,5,0">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="CpuTitle" Text="CPU 使用量" FontSize="12" FontWeight="SemiBold" Foreground="#E8E8EC"/>
                <TextBlock Grid.Column="1" x:Name="CpuNow" Text="—" FontSize="11" Foreground="#9A9AA0"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                  <Canvas x:Name="CpuYLabels" Grid.Column="0" Width="52" Height="118"/>
                <Canvas x:Name="CpuChart" Grid.Column="1" Height="118" ClipToBounds="True"/>
              </Grid>
                <Canvas x:Name="CpuXLabels" Height="14" Margin="52,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#17171A" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="5,0">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="MemTitle" Text="内存使用量" FontSize="12" FontWeight="SemiBold" Foreground="#E8E8EC"/>
                <TextBlock Grid.Column="1" x:Name="MemNow" Text="—" FontSize="11" Foreground="#9A9AA0"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                  <Canvas x:Name="MemYLabels" Grid.Column="0" Width="52" Height="118"/>
                <Canvas x:Name="MemChart" Grid.Column="1" Height="118" ClipToBounds="True"/>
              </Grid>
                <Canvas x:Name="MemXLabels" Height="14" Margin="52,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#17171A" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="5,0,0,0">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="NetTitle" Text="网络流量" FontSize="12" FontWeight="SemiBold" Foreground="#E8E8EC"/>
                <TextBlock Grid.Column="1" x:Name="NetNow" Text="—" FontSize="11" Foreground="#9A9AA0"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                  <Canvas x:Name="NetYLabels" Grid.Column="0" Width="52" Height="118"/>
                <Canvas x:Name="NetChart" Grid.Column="1" Height="118" ClipToBounds="True"/>
              </Grid>
                <Canvas x:Name="NetXLabels" Height="14" Margin="52,4,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ★ 服务器终端（指令输出 + 服务器日志 合并，类 MCSManager 终端面板） -->
        <Border Grid.Row="3" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10" ClipToBounds="True">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,9,14,7">
              <TextBlock Grid.Column="0" Text="服务器终端" FontSize="11" Foreground="#9BA3AE"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <CheckBox x:Name="ChkAutoScroll" Content="自动滚动" FontSize="11" IsChecked="True"/>
                <Button x:Name="BtnClearTerm" Content="清屏" FontSize="11" Padding="8,1" CornerRadius="6" Click="OnClearTerm"/>
              </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Bottom" BorderBrush="#242A33" BorderThickness="0,1,0,0" Padding="12,9,12,11" Background="#101013">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" x:Name="PromptText" Text="@ 全部世界" FontSize="12" FontWeight="SemiBold" Foreground="#0A84FF" VerticalAlignment="Center" Margin="0,0,9,0" FontFamily="Cascadia Mono,Consolas,monospace"/>
                <TextBox Grid.Column="1" x:Name="CmdBox" Watermark="输入指令回车执行：@Dev /save · @2 /save · 不写前缀 = 全部世界 · 以 &gt; 开头 = 服务端控制台口径（输出显示在上方日志流）" FontSize="12" CornerRadius="8" FontFamily="Cascadia Mono,Consolas,monospace"/>
                <Button Grid.Column="2" x:Name="SendBtn" Content="发送" Margin="9,0,0,0" CornerRadius="8"/>
              </Grid>
            </Border>
            <!-- ★ 自检修复（卡顿主因）：原来是 ScrollViewer + ItemsControl，Avalonia 的 ItemsControl 不虚拟化，
                 300~1500 个 TextBlock（且 TextWrapping=Wrap）会让任何布局变化都重新测量整个日志 —— 改成 ListBox（自带虚拟化）。 -->
            <ListBox x:Name="TermLines" Padding="0,0,12,0" Background="#0E0E10" BorderThickness="0" CornerRadius="0"
                     ScrollViewer.AllowAutoHide="False" SelectionMode="Single" IsTabStop="False">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="Focusable" Value="False"/>
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12"
                             FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap" Margin="12,0,12,1"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <!-- 文件管理视图（类 MCSManager）+ 插件启用开关 -->
      <Grid x:Name="PluginsView" IsVisible="False" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="文件管理" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="FileInfo" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="← 返回控制台" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnBackToConsole"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
          <Button Content="⬆ 上级" FontSize="12" Padding="10,5" CornerRadius="8" Click="OnFileUp"/>
          <Button Content="&#xE80F;  根目录" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" FontSize="12" Padding="10,5" CornerRadius="8" Click="OnFileRoot"/>
          <Button Content="＋ 新建文件夹" FontSize="12" Padding="10,5" CornerRadius="8" Click="OnFileMkdir"/>
          <Button Content="刷新" FontSize="12" Padding="10,5" CornerRadius="8" Click="OnFileRefresh"/>
          <Button Content="⬇ 上传文件" FontSize="12" Padding="10,5" CornerRadius="8" Click="OnFileUpload"/>
          <Button Content="✕ 取消传输" FontSize="12" Padding="10,5" CornerRadius="8" Click="OnFileCancelTransfer"/>
          <TextBlock x:Name="FilePathText" Text="—" FontSize="11" Foreground="#9BA3AE" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="点文件名可编辑；点文件夹进入；.dll 行可勾选启用/停用" FontSize="11" Foreground="#9BA3AE" Margin="36,10,36,8" TextWrapping="Wrap"/>
              <!-- ★ 表头的左右内缩必须与行一致：行在 ScrollViewer Padding(0,0,12,0) + PluginList Margin(10,0,10,12) + 行内 Padding(14) 里，
                   合计左右各 36；原来表头只缩进 14 → 行整体左移 8px（用户反馈"大小/修改时间/启用对不齐"）。 -->
              <Grid ColumnDefinitions="*,90,130,64,120" Margin="36,0,36,6">
                <TextBlock Grid.Column="0" Text="名称" FontSize="11" FontWeight="SemiBold" Foreground="#848D9A"/>
                <TextBlock Grid.Column="1" Text="大小" FontSize="11" FontWeight="SemiBold" Foreground="#848D9A"/>
                <TextBlock Grid.Column="2" Text="修改时间" FontSize="11" FontWeight="SemiBold" Foreground="#848D9A"/>
                <TextBlock Grid.Column="3" Text="启用" FontSize="11" FontWeight="SemiBold" Foreground="#848D9A" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="操作（下载/删除）" FontSize="11" FontWeight="SemiBold" Foreground="#848D9A" HorizontalAlignment="Center"/>
              </Grid>
              <Border Height="1" Background="#26262B" Margin="36,0,36,4"/>
            </StackPanel>
            <ScrollViewer ScrollViewer.AllowAutoHide="False" Padding="0,0,12,0">
              <StackPanel x:Name="PluginList" Margin="10,0,10,12" Spacing="2"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- 管理器插件视图宿主 -->
      <Grid x:Name="ExtView" IsVisible="False" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="ExtTitle" Text="扩展" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="ExtDesc" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="← 返回控制台" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnBackToConsole"/>
        </Grid>
        <Border Grid.Row="1" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Padding="16,14">
          <ScrollViewer ScrollViewer.AllowAutoHide="False" Padding="0,0,13,0">
            <ContentControl x:Name="ExtContent"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 管理器插件管理视图（P0-2：列表 / 启用停用 / 重载 / 打开目录 / 失败原因）-->
      <Grid x:Name="MgrPluginsView" IsVisible="False" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="插件管理" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="MgrPluginInfo" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="← 返回控制台" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnBackToConsole"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
          <Button Content="&#xE72C;  重新加载" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" FontSize="12" Padding="10,5" CornerRadius="8" Click="OnMgrPluginsReload"/>
          <Button Content="&#xE8B7;  打开插件目录" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" FontSize="12" Padding="10,5" CornerRadius="8" Click="OnMgrPluginsOpenDir"/>
          <CheckBox x:Name="ChkPluginWatch" Content="监视目录自动重载" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="plugins 目录里 dll/manifest 变化后自动卸载并重新加载（默认关闭）"/>
          <TextBlock Text="插件语言" FontSize="12" Foreground="#9BA3AE" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <ComboBox x:Name="CmbLang" Width="104" FontSize="12" VerticalAlignment="Center" SelectionChanged="OnLangChanged" ToolTip.Tip="插件用 ctx.L(...) 取字符串时使用">
            <ComboBoxItem>zh-CN</ComboBoxItem>
            <ComboBoxItem>en-US</ComboBoxItem>
          </ComboBox>
          <TextBlock x:Name="MgrPluginPath" Text="—" FontSize="11" Foreground="#9BA3AE" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <ScrollViewer ScrollViewer.AllowAutoHide="False" Padding="0,0,12,0">
            <StackPanel x:Name="MgrPluginList" Margin="12,10,12,12" Spacing="2"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 维护视图（整链重置 / 备份 / 恢复 三合一） -->
      <Grid x:Name="MaintView" IsVisible="False" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="维护" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="MaintInfo" Text="整链重置 / 备份存档 / 恢复存档" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="← 返回控制台" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnBackToConsole"/>
        </Grid>
        <Border Grid.Row="1" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <ScrollViewer ScrollViewer.AllowAutoHide="False" Padding="0,0,12,0">
            <StackPanel Margin="18,16,18,18" Spacing="10">
              <TextBlock Text="&#xE72C;  整链重置" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" FontSize="13.5" FontWeight="SemiBold" Foreground="#E8E8EC"/>
              <TextBlock Text="按启动器世界列表重新生成源地图，再切成 N 份替换所有世界。会覆盖现有世界文件 ✗ 过程中服务端会自动重启。" FontSize="11" Foreground="#9A9AA0" TextWrapping="Wrap"/>
              <Button Content="开始整链重置（需点两次确认）" FontSize="12" Padding="14,7" CornerRadius="8" HorizontalAlignment="Left" Click="OnResetClicked"/>
              <Border Height="1" Background="#26262B" Margin="0,10"/>
              <TextBlock Text="&#xE74E;  备份存档" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" FontSize="13.5" FontWeight="SemiBold" Foreground="#E8E8EC"/>
              <TextBlock Text="把 Worlds 与 config 打包成 zip 存到 utsl-deploy\backup。建议在重置/改配置前先备份。" FontSize="11" Foreground="#9A9AA0" TextWrapping="Wrap"/>
              <Button Content="立即备份" FontSize="12" Padding="14,7" CornerRadius="8" HorizontalAlignment="Left" Click="OnBackup"/>
              <Border Height="1" Background="#26262B" Margin="0,10"/>
              <TextBlock Text="♻  恢复存档" FontSize="13.5" FontWeight="SemiBold" Foreground="#E8E8EC"/>
              <TextBlock Text="从 backup 目录里最新的 zip 恢复 Worlds 与 config。会覆盖当前文件 ✗ 建议先停服 ✗ 需点两次确认。" FontSize="11" Foreground="#E3B341" TextWrapping="Wrap"/>
              <Button Content="从最近备份恢复（需点两次确认）" FontSize="12" Padding="14,7" CornerRadius="8" HorizontalAlignment="Left" Click="OnRestoreClicked"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>


      <!-- 连接设置视图（远端管理） -->
      <!-- ===== 文件编辑（类 MCSManager：一次一个文件，保存 / 重新加载 / 返回；编辑器控件在代码里创建） ===== -->
      <Grid x:Name="EditView" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,8">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="EditTitle" Text="编辑文件" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="EditPathText" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button x:Name="BtnEditSave" Content="保存 (Ctrl+S)" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnEditSave"/>
            <Button Content="↻ 重新加载" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnEditReload"/>
            <Button Content="← 返回文件列表" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnEditBack"/>
            <CheckBox x:Name="ChkEditorWrap" Content="自动换行" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Click="OnEditorWrapChanged"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="EditHint" Grid.Row="1" Text="" FontSize="11" Foreground="#FEBC2E" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <!-- 编辑区背景：深藏青（与编辑器控件内背景一致，避免边缘露出灰色底） -->
        <Border Grid.Row="2" Background="#101B2E" BorderBrush="#22314D" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <Panel x:Name="EditHost"/>
        </Border>
        <TextBlock x:Name="EditStatus" Grid.Row="3" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,6,0,0" TextWrapping="NoWrap"/>
      </Grid>
      <Grid x:Name="ConnView" IsVisible="False" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="连接设置" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="ConnInfo" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="← 返回控制台" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnBackToConsole"/>
        </Grid>
        <Border Grid.Row="1" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <ScrollViewer ScrollViewer.AllowAutoHide="False" Padding="0,0,12,0">
            <StackPanel x:Name="ConnHostPanel" Margin="18,16,18,18" Spacing="8"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 世界链可视化视图 -->
      <Grid x:Name="ChainView" IsVisible="False" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,12">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="世界链" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="ChainInfo" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="刷新" FontSize="12" Padding="12,5" CornerRadius="8" Margin="0,0,8,0" Click="OnShowChain"/>
          <Button Grid.Column="2" Content="← 返回控制台" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnBackToConsole"/>
        </Grid>
        <Border Grid.Row="1" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <ScrollViewer ScrollViewer.AllowAutoHide="False" Padding="0,0,12,0" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChainHost" Margin="18,16,18,18" Spacing="16"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 配置编辑视图（表单由代码生成） -->
      <Grid x:Name="ConfigView" IsVisible="False" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,12">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="配置编辑" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="ConfigInfo" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="保存并备份旧配置" FontSize="12" Padding="12,5" CornerRadius="8" Margin="0,0,8,0" Click="OnSaveConfig"/>
          <Button Grid.Column="2" Content="← 返回控制台" FontSize="12" Padding="12,5" CornerRadius="8" Click="OnBackToConsole"/>
        </Grid>
        <Border Grid.Row="1" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <ScrollViewer ScrollViewer.AllowAutoHide="False" Padding="0,0,12,0">
            <StackPanel x:Name="ConfigHost" Margin="16,14,16,18" Spacing="8"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 地图预览视图（切换而非弹窗） -->
      <Grid x:Name="MapView" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto">
        <!-- 行 0：标题 + 状态 + 返回。工具栏不挤在这一行，让它有整行宽度好自动换行 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,8">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="地图预览" FontSize="19" FontWeight="SemiBold" Foreground="#F2F2F5"/>
            <TextBlock x:Name="MapInfo" Text="—" FontSize="11" Foreground="#9BA3AE" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="← 返回控制台" FontSize="12" Padding="12,5" CornerRadius="8"
                  VerticalAlignment="Center" Click="OnBackToConsole"/>
        </Grid>
        <!-- 行 1：工具栏。★ 用 WrapPanel 而非 StackPanel：控件多（宿主 6 个 + 插件若干）时窄窗口能自动换行，
             否则会被挤出可视区。v4 的插件贡献点也把控件追加到这个面板里（MapPluginBar 就是它本身）。 -->
        <WrapPanel Grid.Row="1" x:Name="MapPluginBar" Orientation="Horizontal" Margin="0,0,0,10">
          <ComboBox x:Name="MapPicker" FontSize="12" Width="170" Margin="0,0,6,6" SelectionChanged="OnMapPickChanged"/>
          <Button Content="适应" FontSize="12" Padding="10,5" CornerRadius="8" Margin="0,0,6,6" Click="OnMapFit"/>
          <Button Content="1:1" FontSize="12" Padding="10,5" CornerRadius="8" Margin="0,0,6,6" Click="OnMapActual"/>
          <Button Content="−" FontSize="12" Width="32" Padding="0,5" CornerRadius="8" Margin="0,0,6,6" Click="OnMapZoomOut"/>
          <Button Content="+" FontSize="12" Width="32" Padding="0,5" CornerRadius="8" Margin="0,0,6,6" Click="OnMapZoomIn"/>
          <Button Content="刷新" FontSize="12" Padding="10,5" CornerRadius="8" Margin="0,0,6,6" Click="OnRefreshMap"/>
        </WrapPanel>
        <Border Grid.Row="2" x:Name="MapCard" Background="#171A20" BorderBrush="#242A33" BorderThickness="1" CornerRadius="12" ClipToBounds="True"
                Cursor="Hand" PointerWheelChanged="OnMapWheel"
                PointerPressed="OnMapPointerPressed" PointerMoved="OnMapPointerMoved"
                PointerReleased="OnMapPointerReleased" DoubleTapped="OnMapDoubleTapped">
          <!-- 地图视口：用 RenderTransform 缩放/平移（不触发布局，缩放与位移同帧生效，
               避免"新尺寸 + 旧偏移"渲染出的一帧错位/闪烁） -->
          <!-- ★ 必须用 Canvas：Panel 会把子元素的排列矩形夹到视口大小，
               Stretch=None 时就只画左上角一块（实测 Panel 下 Bounds=1440x1100，Canvas 下=12000x2400） -->
          <Canvas x:Name="MapSurface" ClipToBounds="True">
            <Image x:Name="MapImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" PointerWheelChanged="OnMapWheel"/>
            <Rectangle x:Name="MapSelectRect" IsVisible="False" IsHitTestVisible="False"
                       Fill="#3366CCFF" Stroke="#66CCFF" StrokeThickness="1.5"/>
          </Canvas>
        </Border>
        <!-- 卡片下方的加载进度条（渲染/解码时显示；浅蓝取管理器强调色 #66CCFF） -->
        <ProgressBar Grid.Row="3" x:Name="MapProgress" Minimum="0" Maximum="1" Height="4" Margin="2,10,2,0"
                     Foreground="#66CCFF" Background="#1E1E24" IsVisible="False">
          <!-- 0.25s 过渡：进度值变化时是"滑过去"而不是"跳过去" -->
          <ProgressBar.Transitions>
            <Transitions>
              <DoubleTransition Property="Value" Duration="0:0:0.25"/>
            </Transitions>
          </ProgressBar.Transitions>
        </ProgressBar>
      </Grid>

      </Panel>

      <!-- ★ 右侧功能菜单（插件/地图等迁移到这里） -->
      <Border Grid.Row="1" Grid.Column="2" Background="#16161A" Padding="12,10">
        <ScrollViewer ScrollViewer.AllowAutoHide="False" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="MenuPanel" Spacing="6">
          <TextBlock Text="服务端" FontSize="11" FontWeight="SemiBold" Foreground="#9BA3AE" Margin="4,0,0,6"/>
          <Border Background="#1C1C1F" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="8" Padding="10,7">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border x:Name="SrvDot" Width="7" Height="7" CornerRadius="3.5" Background="#6B6B70" VerticalAlignment="Center"/>
              <TextBlock x:Name="ConnState" Text="未运行" FontSize="11" Foreground="#9A9AA0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <!-- ★ 连接健康三灯（移植 MCSManager 的显式连接状态思路）：隧道 / 命令通道 / REST 接口 -->
          <Border Background="#1C1C1F" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,4,0,0" ToolTip.Tip="绿灯=正常；橙灯=降级/回退；灰灯=未启用">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border x:Name="DotTunnel" Width="7" Height="7" CornerRadius="3.5" Background="#6B6B70" VerticalAlignment="Center"/>
                <TextBlock Text="隧道" FontSize="11" Foreground="#9A9AA0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border x:Name="DotShell" Width="7" Height="7" CornerRadius="3.5" Background="#6B6B70" VerticalAlignment="Center"/>
                <TextBlock Text="通道" FontSize="11" Foreground="#9A9AA0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border x:Name="DotRest" Width="7" Height="7" CornerRadius="3.5" Background="#6B6B70" VerticalAlignment="Center"/>
                <TextBlock Text="接口" FontSize="11" Foreground="#9A9AA0" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <Button Grid.Column="0" x:Name="BtnStart" Content="▶  启动" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,6" CornerRadius="8" Margin="0,0,3,0" Click="OnStartServer"/>
            <Button Grid.Column="1" x:Name="BtnStop" Content="■  停止" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,6" CornerRadius="8" Margin="3,0,0,0" Click="OnStopServer"/>
          </Grid>
          <Button x:Name="BtnRestart" Content="⟳  重启服务端" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,6" CornerRadius="8" Click="OnRestartServer"/>
          <CheckBox x:Name="ChkWatchdog" Content="掉线自启" FontSize="12" Margin="4,2,0,0"/>
          <TextBlock x:Name="PluginMetricsHeader" Text="插件指标" FontSize="11" FontWeight="SemiBold" Foreground="#9BA3AE" Margin="4,14,0,6" IsVisible="False"/>
          <StackPanel x:Name="PluginMetricsHost" Spacing="4"/>
          <TextBlock Text="功能" FontSize="11" FontWeight="SemiBold" Foreground="#9BA3AE" Margin="4,14,0,6"/>
          <Button x:Name="BtnConn" Classes="menu" Content="&#xE774;  连接设置" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" CornerRadius="8" Click="OnShowConn"/>
          <Button x:Name="BtnChain" Classes="menu" Content="&#xE71B;  世界链" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" CornerRadius="8" Click="OnShowChain"/>
          <Button x:Name="BtnConfig" Classes="menu" Content="&#xE713;  配置编辑" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" CornerRadius="8" Click="OnShowConfig"/>
          <Button x:Name="BtnPlugins" Classes="menu" Content="&#xE8B7;  文件管理" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" CornerRadius="8" Click="OnShowPlugins"/>
          <Button x:Name="BtnMap" Classes="menu" Content="&#xE707;  地图预览" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" CornerRadius="8" Click="OnShowMap"/>
          <Button x:Name="BtnMaint" Classes="menu" Content="&#xE90F;  维护" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" CornerRadius="8" Click="OnShowMaint"/>
          <Button x:Name="BtnMgrPlugins" Classes="menu" Content="&#xEA86;  插件管理" FontFamily="Segoe MDL2 Assets, Microsoft YaHei" CornerRadius="8" Click="OnShowMgrPlugins"/>
          <!-- 下面的按钮已合并进「维护」视图，保留元素是为了不破坏代码里对 BtnReset/BtnBackup/BtnRestore 的引用 -->
          <StackPanel IsVisible="False">
            <Button x:Name="BtnReset" Click="OnResetClicked"/>
            <Button x:Name="BtnBackup" Click="OnBackup"/>
            <Button x:Name="BtnRestore" Click="OnRestoreClicked"/>
          </StackPanel>
          <TextBlock x:Name="ExtHeader" Text="扩展" FontSize="11" FontWeight="SemiBold" Foreground="#9BA3AE" Margin="4,14,0,6" IsVisible="False"/>
          <StackPanel x:Name="ExtPanel" Spacing="6"/>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Panel>
</Window>
