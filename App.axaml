<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mac="clr-namespace:Devolutions.AvaloniaTheme.MacOS;assembly=Devolutions.AvaloniaTheme.MacOS"
             x:Class="UTSLManager.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <!-- ★ AvaloniaEdit 必须显式引入它的主题样式，否则 TextEditor 的模板不渲染 → 编辑区一片空白（实机踩到）。
         资源路径从 AvaloniaEdit.dll 里扫出来的真实值：/Themes/Fluent/AvaloniaEdit.xaml（另有 Simple 与 Base）。 -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <mac:DevolutionsMacOsTheme />
    <mac:DevolutionsMacOsThemeGlobalStyles />

    <!-- ===== 视觉层（L0 材质 / L1 面与线 / L3 尺度 / L4 动效·图标 / 全局字体链·滚动条）=====
         ★ 已抽到 UTSLManager.Ui，与「UTSL 世界生成器」共用同一份；本文件不再内联任何样式。
           顺序与内容见 avares://UTSLManager.Ui/Theme.axaml。 -->
    <StyleInclude Source="avares://UTSLManager.Ui/Theme.axaml" />
  </Application.Styles>
</Application>
