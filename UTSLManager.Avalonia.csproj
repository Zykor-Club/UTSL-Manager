<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- 地图渲染要走指针直写像素缓冲 + 按行并行（见 Maps\WorldMapRenderer.cs） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>UTSLManager</RootNamespace>
    <AssemblyName>UTSLManager</AssemblyName>
    <!-- 发布输出目录：默认取仓库上两级的 AvaloniaUTSL\（本机即 桌面\AvaloniaUTSL\，与过去位置一致）；
         也可以用 -p:PublishDir=你的路径\ 覆盖。不在仓库里硬编码任何个人绝对路径。 -->
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\AvaloniaUTSL\</PublishDir>
  </PropertyGroup>
  <!-- 示例插件是独立工程：不要被主工程的默认通配符编译进 UTSLManager.dll -->
  <ItemGroup>
    <Compile Remove="samples\**" />
    <None Remove="samples\**" />
    <EmbeddedResource Remove="samples\**" />
    <AvaloniaResource Remove="samples\**" />
    <!-- ★ P0：插件契约是独立工程（子目录），绝不能被主工程的通配符编进来 ——
         否则同一批类型会同时存在于两个程序集，类型转发直接报 CS0729。
         这一条和上面的 samples/extensions/third_party 是同一类排除。 -->
    <Compile Remove="UTSLManager.Plugin.Abstractions\**" />
    <None Remove="UTSLManager.Plugin.Abstractions\**" />
    <EmbeddedResource Remove="UTSLManager.Plugin.Abstractions\**" />
    <AvaloniaResource Remove="UTSLManager.Plugin.Abstractions\**" />
    <!-- extensions/ 是「正式管理器插件」的源码目录（同样独立工程，不要被主工程编进去） -->
    <Compile Remove="extensions\**" />
    <None Remove="extensions\**" />
    <EmbeddedResource Remove="extensions\**" />
    <AvaloniaResource Remove="extensions\**" />
  </ItemGroup>
  <!-- third_party/ 是外部依赖源码（TEdit，见 scripts\get-tedit.ps1）：它有自己的一堆工程（含测试工程），
       绝不能被主工程的默认通配符编进来（否则 5000+ 编译错误） -->
  <ItemGroup>
    <Compile Remove="third_party\**" />
    <None Remove="third_party\**" />
    <EmbeddedResource Remove="third_party\**" />
    <AvaloniaResource Remove="third_party\**" />
    <!-- ★ 还要排掉 XAML：Avalonia SDK 会把 **/*.axaml 收成 AvaloniaXaml，
         TEdit5 里有一堆 .axaml（App/Views/Styles），不排掉会报 AVLN2000 -->
    <AvaloniaXaml Remove="third_party\**" />
  </ItemGroup>
  <!--
    ★ 世界地图：把 .wld 解析/渲染直接编进管理器本体（不再做成扩展插件）。
    TEdit 的渲染核心在 TEdit5（一个 WinExe 工程）里，不能引用，所以从源码里只挑需要的文件编进来；
    TEdit.Terraria / TEdit.Common 是普通库工程，直接 ProjectReference（源码见 scripts\get-tedit.ps1）。
    SkiaSharp 对齐 Avalonia 自带版本，避免同进程里出现两个 SkiaSharp。
  -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="ReactiveUI" Version="24.3.0" />
    <ProjectReference Include="third_party\TEdit\src\TEdit.Terraria\TEdit.Terraria.csproj" />
    <!-- ★ P0：插件契约独立程序集。命名空间仍是 UTSLManager.Plugins，管理器用 Plugins\TypeForwards.cs 做类型转发
         （旧插件 dll 与旧插件源码都无需改动）；输出目录里有了这个 dll 后，PluginHost.BuildHostAssemblies
         会自动把它算作宿主程序集，插件拿到的永远是宿主那一份类型。 -->
    <ProjectReference Include="UTSLManager.Plugin.Abstractions\UTSLManager.Plugin.Abstractions.csproj" />
    <Compile Include="third_party\TEdit\src\TEdit5\Controls\PixelMap.cs" Link="TEdit5\PixelMap.cs" />
    <Compile Include="third_party\TEdit\src\TEdit5\Controls\WorldRenderEngine\SkiaTEditExtensions.cs" Link="TEdit5\SkiaTEditExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- 文件编辑器（在线编辑 + 语法高亮 + 波浪线）。实测与 Avalonia 12.1.2 兼容，且它依赖的 SkiaSharp 恰为 3.119.4（与本工程同版本，不会同进程两份） -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Devolutions.AvaloniaTheme.MacOS" Version="*" />
    <!-- P2-12：.csx 脚本插件（Roslyn） -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <!-- v6：Lua 插件（社区里有 Lua 作者）。实测 2.0.0 在 net10.0 可还原/可运行，体积仅 349KB；
         用官方软沙箱预设，并额外剔除 os/package（实测软沙箱仍保留这两个）。 -->
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
  <!-- daemon/ 是独立工程（UTSLDaemon），别被管理器的 SDK 通配顺手编进来 -->
  <ItemGroup>
    <Compile Remove="daemon/**" />
    <None Remove="daemon/**" />
    <EmbeddedResource Remove="daemon/**" />
    <AvaloniaResource Remove="daemon/**" />
  </ItemGroup>

</Project>