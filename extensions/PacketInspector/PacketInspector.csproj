<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PacketInspector —— 管理器侧「数据包查看器」插件（正式插件，不是示例）。
    配套服务端插件：UTSLServerPlugin/src/NetPacketChannel（提供 REST /packets 系列）。

    构建（默认自动部署到 <管理器目录>\plugins\）：
      dotnet build -c Release
      dotnet build -c Release -p:ManagerDir=D:\path\to\AvaloniaUTSL
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PacketInspector</AssemblyName>
    <RootNamespace>PacketInspector</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <ManagerDir Condition="'$(ManagerDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\..\..\AvaloniaUTSL\UTSLManager.dll')">$(MSBuildThisFileDirectory)..\..\..\..\AvaloniaUTSL</ManagerDir>
    <ManagerDir Condition="'$(ManagerDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\net10.0\UTSLManager.dll')">$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\net10.0</ManagerDir>
    <ManagerDir Condition="'$(ManagerDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\AvaloniaUTSL</ManagerDir>
    <PluginDeployDir Condition="'$(PluginDeployDir)' == ''">$(ManagerDir)\plugins</PluginDeployDir>
    <PluginManifestSource>$(MSBuildThisFileDirectory)manifest.json</PluginManifestSource>
  </PropertyGroup>

  <Target Name="CheckManagerExists" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ManagerDir)\UTSLManager.Plugin.Abstractions.dll')"
           Text="找不到 $(ManagerDir)\UTSLManager.dll —— 请用 -p:ManagerDir=&lt;UTSLManager 所在目录&gt; 指定。" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <!-- ★ P0 起：插件只需引用【契约程序集】（约 26KB），不再拖整个 UTSLManager.dll。
         契约命名空间仍是 UTSLManager.Plugins，源码里 using 一行都不用改。 -->
    <Reference Include="UTSLManager.Plugin.Abstractions">
      <HintPath>$(ManagerDir)\UTSLManager.Plugin.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToManager" AfterTargets="Build">
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" ContinueOnError="true" Retries="0" />
    <Copy SourceFiles="$(PluginManifestSource)"
          DestinationFiles="$(PluginDeployDir)\$(AssemblyName).manifest.json"
          Condition="Exists('$(PluginManifestSource)')" ContinueOnError="true" Retries="0" />
    <Message Importance="high" Text="[PacketInspector] 部署目标：$(PluginDeployDir)" />
  </Target>

</Project>
